{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperscroll.vercel.app/schemas/digest-v1.json",
  "title": "PaperScroll morning digest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "schemaUrl",
    "source",
    "board",
    "composition",
    "delivery",
    "instruction",
    "papers"
  ],
  "properties": {
    "schema": { "const": "paperscroll.digest" },
    "schemaVersion": { "const": "1.2" },
    "schemaUrl": { "type": ["string", "null"], "format": "uri" },
    "source": { "const": "PaperScroll" },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "date",
        "label",
        "publishedAt",
        "complete",
        "count",
        "membership",
        "selectionVersion",
        "packetBasis",
        "orderedPaperIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/date" },
        "version": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
        "date": { "$ref": "#/$defs/date" },
        "label": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "complete": { "const": true },
        "count": { "const": 10 },
        "membership": { "const": "shared" },
        "selectionVersion": { "type": "string", "minLength": 1 },
        "packetBasis": {
          "enum": ["title-and-abstract", "full-paper", "host-written"]
        },
        "orderedPaperIds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "desk", "order"],
      "properties": {
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["AI", "Stats", "Math", "Econ", "Health", "Engineering", "Physics", "Security"]
          }
        },
        "desk": { "type": ["string", "null"], "maxLength": 200 },
        "order": { "enum": ["shared-board", "account-fields-first"] }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "semantics"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "semantics": { "type": "string", "minLength": 1 }
      }
    },
    "instruction": { "type": "string", "minLength": 1 },
    "papers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/paper" }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper", "code"],
      "properties": {
        "paper": { "type": ["string", "null"], "format": "uri" },
        "code": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "verdictWhy", "reported", "metrics", "brief", "takeaways", "actions", "links", "automation", "plain"],
      "properties": {
        "verdict": { "enum": ["Try", "Watch", "Skip", null] },
        "verdictWhy": { "type": ["string", "null"], "minLength": 1 },
        "reported": { "type": ["string", "null"], "minLength": 1 },
        "metrics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "brief": { "type": "string", "minLength": 1 },
        "takeaways": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "links": { "$ref": "#/$defs/links" },
        "automation": {
          "type": ["object", "null"],
          "required": ["boardRank", "selection", "basis", "model"],
          "properties": {
            "boardRank": { "type": "integer", "minimum": 1, "maximum": 10 },
            "selection": { "type": "string", "minLength": 1 },
            "basis": { "enum": ["title-and-abstract", "full-paper"] },
            "model": { "type": "string", "minLength": 1 }
          }
        },
        "plain": {
          "type": ["object", "null"],
          "required": ["verdictWhy", "reported", "brief", "takeaways"],
          "properties": {
            "verdictWhy": { "type": ["string", "null"], "minLength": 1 },
            "reported": { "type": ["string", "null"], "minLength": 1 },
            "brief": { "type": "string", "minLength": 1 },
            "takeaways": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "arxivId", "url", "github", "title", "authors", "topic", "packet", "page", "focus", "trend", "markdown"],
      "properties": {
        "source": { "const": "PaperScroll" },
        "id": { "type": "string", "minLength": 1 },
        "arxivId": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "github": { "type": ["string", "null"], "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "packet": { "$ref": "#/$defs/packet" },
        "page": { "type": ["string", "null"], "format": "uri" },
        "focus": { "type": "boolean" },
        "trend": { "type": ["object", "null"] },
        "markdown": { "type": "string", "minLength": 1 }
      }
    }
  }
}
